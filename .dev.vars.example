# Local development configuration — copy to .dev.vars (gitignored).
# The production board API (local monorepo dev: http://localhost:3000/api —
# note the /api prefix; only api.cavuno.com rewrites /v1 → /api/v1).
CAVUNO_API_URL=https://api.cavuno.com
# The board this frontend renders — its pk_… publishable key.
# Default: the production Robotics Engineer Jobs board — the same real-data
# reference board used by the other Cavuno starters.
CAVUNO_BOARD=pk_d9ce40a106227b615ec710de3f3d73dc
