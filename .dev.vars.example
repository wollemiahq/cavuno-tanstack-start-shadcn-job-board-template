# Local development configuration — copy to .dev.vars (gitignored).
# Board API base URL — leave as-is.
CAVUNO_API_URL=https://api.cavuno.com
# The board this frontend renders — its pk_… publishable key.
# Default: the platform SANDBOX fixture board (`sandbox: true`) — the
# state-complete feature showcase. Grounding here lights up the developer
# preview toolbar (persona switching, board-settings toggles, reseed).
# This is the sandbox's real, deliberately-published key (see
# docs/preview-states.md) — data resets nightly; safe for write probes.
CAVUNO_BOARD=pk_c2f66367a3abaa6bafd00fd3c2de3297
# Template-developer chrome (the "Development preview" pill that previews ad
# placements without serving ads). Opt-in so hosted previews such as the AI
# builder, which also run the dev server, never show it to board owners.
CAVUNO_DEV_TOOLS=1
