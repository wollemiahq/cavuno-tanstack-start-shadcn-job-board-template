{
  "name": "cavuno-tanstack-start-shadcn-job-board-template",
  "private": true,
  "description": "A production-ready TanStack Start + shadcn/ui job board template powered by Cavuno.",
  "keywords": [
    "base-ui",
    "job-board",
    "react",
    "shadcn-ui",
    "tailwindcss",
    "tanstack",
    "tanstack-start",
    "template"
  ],
  "homepage": "https://cavuno.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wollemiahq/cavuno-tanstack-start-shadcn-job-board-template.git"
  },
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "predev": "pnpm run gen:paraglide",
    "dev": "vp dev --port 3000",
    "build": "vp build",
    "check:bundle": "node scripts/check-bundle-budgets.mjs",
    "perf:lighthouse": "pnpm run build && node scripts/lighthouse-matrix.mjs --runs=1",
    "perf:lighthouse:check": "pnpm run build && node scripts/lighthouse-matrix.mjs --check --runs=3",
    "preview": "pnpm run build && vp preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:locale": "node scripts/test-foreign-locale.mjs",
    "check": "vp fmt -c .oxfmtrc.json --check && vp check --no-fmt",
    "check:shadcn": "node scripts/check-shadcn-components.mjs",
    "predeploy": "node scripts/check-board-key.mjs",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "gen:messages": "node scripts/gen-paraglide-messages.mjs",
    "locale:add": "node scripts/locale-add.mjs",
    "gen:shadcn": "node scripts/check-shadcn-components.mjs --write",
    "gen:paraglide": "node scripts/gen-paraglide.mjs --project ./project.inlang --outdir ./src/paraglide --output-structure locale-modules --strategy url baseLocale",
    "pretest": "pnpm run gen:paraglide && pnpm run gen:theme",
    "pretypecheck": "pnpm run gen:paraglide",
    "gen:theme": "node scripts/gen-theme-resolved.mjs",
    "gen:design": "node scripts/gen-design.mjs",
    "theme:apply": "node scripts/theme-apply.mjs",
    "icons:apply": "node scripts/icons-apply.mjs",
    "rtl:apply": "node scripts/rtl-apply.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@cavuno/board": "4.38.0",
    "@cloudflare/vite-plugin": "1.62.2",
    "@fontsource-variable/crimson-pro": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/lexend": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/open-sans": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource-variable/work-sans": "^5.3.0",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/fira-sans": "^5.3.0",
    "@fontsource/hind": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@internationalized/date": "3.12.4",
    "@paper-design/shaders-react": "0.0.81",
    "@react-aria/utils": "3.34.1",
    "@react-stately/utils": "3.12.1",
    "@react-types/overlays": "3.10.0",
    "@react-types/shared": "3.36.1",
    "@shadcn/react": "^0.3.1",
    "@stripe/stripe-js": "9.17.0",
    "@tailwindcss/vite": "4.3.3",
    "@takumi-rs/helpers": "2.14.0",
    "@takumi-rs/wasm": "2.14.0",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "@tanstack/router-plugin": "1.168.42",
    "@tiptap/extension-character-count": "3.31.3",
    "@tiptap/extension-link": "3.31.3",
    "@tiptap/extension-text-align": "3.31.3",
    "@tiptap/extension-underline": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "0.4.0",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.5.0",
    "lucide-react": "^1.49.0",
    "react": "19.3.0",
    "react-aria": "3.52.1",
    "react-aria-components": "1.21.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.3.0",
    "react-resizable-panels": "^4.14.1",
    "react-stately": "3.50.0",
    "recharts": "3.10.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
    "web-vitals": "^6.2.2"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "2.25.4",
    "@inlang/plugin-message-format": "4.4.4",
    "@oxlint/plugins": "1.86.0",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/intent": "0.4.0",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-router-devtools": "1.167.2",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^24",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "lighthouse": "13.5.0",
    "oxlint": "1.86.0",
    "typescript": "7.0.2",
    "typescript-6": "npm:@typescript/typescript6@6.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0",
    "vitest": "5.0.1",
    "wrangler": "4.144.0"
  },
  "packageManager": "pnpm@11.10.0",
  "intent": {
    "skills": [
      "@tanstack/devtools",
      "@tanstack/devtools-event-client",
      "@tanstack/devtools-vite",
      "@tanstack/react-start",
      "@tanstack/router-core",
      "@tanstack/router-plugin",
      "@tanstack/start-client-core",
      "@tanstack/start-server-core"
    ]
  }
}
